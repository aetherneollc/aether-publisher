# Secrets & runtime data — never commit real cookies or account data.
.env
data/accounts/**
!data/accounts/.gitkeep
data/cache/**
!data/cache/.gitkeep
queue/*.local.yaml
*.local.yaml

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Cloned desktop browser profiles (cookies). Never commit.
daily-chrome/
daily-firefox/

# Local Firefox fingerprint copied from the operator's own browser.
config/firefox-fingerprint.yaml

# Browser automation artifacts
verify_code.txt
*.png
!docs/**/*.png
