# Copy to .env and fill in. docker-compose.yml reads this automatically.

# --- Control plane (暮色工房 / anime-factory) pull-mode ---
# Shared secret sent as the `X-Studio-Agent-Key` header on every /ops/* request.
STUDIO_AGENT_KEY=changeme
# Optional Cloudflare Access service-token layer in front of the control plane.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# Optional Aether Account Vault. Batch mode syncs ready account states before publishing.
# Origin only, no path. The vault Access app needs a Service Auth policy for
# CF_ACCESS_CLIENT_ID, and the Worker secret RUNNER_API_TOKEN must match the
# bearer token below.
# AETHER_VAULT_URL=https://aether-account-vault.hero-30b.workers.dev
# AETHER_VAULT_RUNNER_TOKEN=
# Base URL of the control plane Worker.
CONTROL_PLANE_URL=https://anime-factory.hero-30b.workers.dev
# Identifier this publisher agent reports as (shows up in /ops/heartbeat etc).
AGENT_ID=dusk-publisher-01

# --- Ephemeral runner batch ---
MAX_TASKS=3
MAX_MINUTES=240
PLATFORMS=all
# PUBLISHER_IMAGE=ghcr.io/aetherneollc/aether-publisher:main
# WARP_PROXY_IMAGE=ghcr.io/seiry/cloudflare-warp-proxy:2026.5.29

# --- Runtime ---
# Where cookies/, cache/, and (optionally) the local queue file live.
# Inside the container this is /data (see docker-compose.yml volume mount).
DATA_DIR=/data
# Run browsers headless (1) or headed (0). login always forces headed
# regardless of this setting, since it requires a human to sign in.
HEADLESS=1
# Seconds between /ops/work polls in daemon mode.
POLL_INTERVAL_SECONDS=60
# Seconds between real per-account cookie `check()` sweeps (each one launches
# a browser per account — kept infrequent on purpose).
CHECK_INTERVAL_SECONDS=1800
# Seconds between /ops/heartbeat POSTs. Fires on this fixed schedule
# regardless of whether there was any work, so a human watching the control
# plane can tell "alive but idle" apart from "dead" (previously both looked
# like "nothing happened").
HEARTBEAT_INTERVAL_SECONDS=60
# Seconds between the dedicated browser-launch health probe (spawns a
# throwaway headless Chromium to prove patchright/Chromium still works) plus
# the disk-space and cookie-volume-writable checks. Independent of whether
# any accounts are configured.
HEALTH_CHECK_INTERVAL_SECONDS=300
# Below this free space (MB) in DATA_DIR, /healthz reports unhealthy.
DISK_MIN_FREE_MB=1024
# Port the in-process GET /healthz endpoint listens on (daemon mode only).
# Not published to the host by default in docker-compose.yml — see README.
HEALTHZ_PORT=8080

# --- Optional ---
# Explicit proxy for reaching youtube.com/x.com from regions where they are
# blocked or degraded. patchright's Chromium does NOT read the system proxy,
# it must be set explicitly. Example: http://127.0.0.1:7890
# YT_PROXY=
# X_PROXY=
# TIKTOK_PROXY=

# Path (inside the container) to the accounts registry. See config/accounts.example.yaml.
ACCOUNTS_FILE=/app/config/accounts.yaml

# Path (inside the container) to the local queue file, used by `queue run`.
LOCAL_QUEUE_FILE=/app/queue/local_queue.yaml
